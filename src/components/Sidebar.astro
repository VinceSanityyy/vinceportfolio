---
import { profile } from '../data/portfolio.js';
import { icons } from '../data/icons.js';

const { name, role, location, phone, email, photo, socials } = profile;

// Prepend the Astro base path (e.g. "/vinceportfolio") so the image resolves
// correctly both on GitHub Pages and in local preview.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photoSrc = `${base}${photo}`;

const navItems = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
  { id: 'skills', label: 'Skills' },
  { id: 'projects', label: 'Projects' },
  { id: 'interests', label: 'Interests' },
];
---

<aside class="sidebar" aria-label="Primary">
  <button class="nav-toggle" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false">
    <span class="icon-menu" set:html={icons.menu}></span>
    <span class="icon-close" set:html={icons.close}></span>
  </button>

  <div class="sidebar-inner">
    <a href="#about" class="brand" data-nav-link>
      <img src={photoSrc} alt={name} class="brand-photo" width="160" height="160" loading="eager" />
      <span class="brand-name">{name}</span>
      <span class="brand-role">{role}</span>
    </a>

    <nav class="nav" aria-label="Sections">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={`#${item.id}`} data-nav-link>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="socials">
      {socials.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
            <span set:html={icons[s.icon]}></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="sidebar-location">
      <span class="icon" set:html={icons.location}></span>{location}
    </p>
    <p class="sidebar-phone">
      <span class="icon" set:html={icons.phone}></span>{phone}
    </p>
  </div>
</aside>
